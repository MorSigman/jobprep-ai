# JobPrep AI — server environment variables
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env to git — it contains your secret API key.

# OpenAI API key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (optional — defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-5-mini

# Server port (optional — defaults to 8787)
AI_SERVER_PORT=8787
